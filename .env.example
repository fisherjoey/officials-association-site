# Environment variables for this template.
#
# Copy this file to `.env.local` for local development (Next.js loads
# `.env.local` automatically; the test suite also falls back to it — see
# jest.integration.setup.ts). Never commit a populated env file — `.gitignore`
# excludes every variant except this one.
#
# SECURITY: any variable prefixed NEXT_PUBLIC_ is compiled into the browser
# bundle at build time — anyone who loads the site can read it in view-source.
# Never put a secret, API key, or service-role credential behind that prefix.
# Everything else here is server-only (Netlify Functions, `next build`,
# scripts) and never reaches the client.

# -----------------------------------------------------------------------------
# Supabase (required)
# -----------------------------------------------------------------------------

# Project URL and anon key: Supabase dashboard -> Project Settings -> API.
# Public by design (RLS enforces access), but still only meant for this site.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key: same page, "service_role" secret. Bypasses RLS entirely —
# server-only, never NEXT_PUBLIC_. Required for integration tests and any
# Netlify Function that needs elevated access.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# Site identity and branding
# -----------------------------------------------------------------------------
# lib/siteConfig.ts is the single seam for organisation identity. All of the
# following are optional and fall back to neutral placeholders — set the ones
# that apply to your deployment.

NEXT_PUBLIC_ORG_NAME=Your Officials Association
NEXT_PUBLIC_ORG_SHORT_NAME=Your Association
NEXT_PUBLIC_ORG_TAGLINE=Add your tagline here
NEXT_PUBLIC_ORG_LOCATION=Your City, Your Region
NEXT_PUBLIC_ORG_CITY=your city
NEXT_PUBLIC_ORG_REGION=your region
NEXT_PUBLIC_ORG_SPORT=basketball
NEXT_PUBLIC_ORG_FOUNDED_YEAR=YYYY
NEXT_PUBLIC_ORG_MEMBER_COUNT=NNN

# Canonical origin for this deploy — required for a real deploy (used to build
# the auth callback URL and every absolute link the client renders). No other
# source is read; Netlify's own URL/DEPLOY_PRIME_URL build vars are NOT used
# here on purpose (see the comment on SITE_URL in lib/siteConfig.ts).
NEXT_PUBLIC_SITE_URL=https://example.org

# Logo shown in header, footer, portal and auth screens.
NEXT_PUBLIC_ORG_LOGO_URL=/images/logos/org-logo.png

# Brand palette — tailwind.config.ts registers each as a `brand-*` colour.
NEXT_PUBLIC_BRAND_COLOR_PRIMARY=#ff6b35
NEXT_PUBLIC_BRAND_COLOR_PRIMARY_LIGHT=#ff8c5a
NEXT_PUBLIC_BRAND_COLOR_SECONDARY=#2c3e50
NEXT_PUBLIC_BRAND_COLOR_DARK=#1a1a1a
NEXT_PUBLIC_BRAND_COLOR_ACCENT=#3498db

# Social links — leave empty to hide that icon entirely.
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_TWITTER=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_HANDLE=

# Third-party services — empty means "not configured", link/embed hidden.
NEXT_PUBLIC_LINK_ASSIGNING=
NEXT_PUBLIC_LINK_FILM_STUDY=
NEXT_PUBLIC_LINK_COMMUNITY=
NEXT_PUBLIC_LINK_RESOURCE_CENTRE=
NEXT_PUBLIC_LINK_APPLICATION_FORM=

# Mail domain the role addresses below are derived from (e.g. scheduler@<this>).
# Prefixed because components render the domain; the derived addresses
# themselves stay server-only (see the EMAIL_* block below).
NEXT_PUBLIC_EMAIL_DOMAIN=example.org

NEXT_PUBLIC_NEWSLETTER_NAME=Newsletter
NEXT_PUBLIC_STORAGE_PREFIX=oas_

# What the portal calls the requests that arrive from the public
# /get-officials form. The route stays /portal/admin/service-requests.
NEXT_PUBLIC_SERVICE_REQUESTS_NAME=Service Requests

# -----------------------------------------------------------------------------
# Optional portal modules
# -----------------------------------------------------------------------------
# Parts of the portal you can leave out. `false` removes the nav entries AND
# stops the route being written into out/ at all — see "Optional modules" in the
# README for what each one does and what turning it off costs. The defaults are
# in MODULES in lib/siteConfig.ts, and editing them there works just as well.
#
# Read at build time only. Changing one needs a rebuild and a redeploy, and it
# leaves the Netlify Function and the Supabase table behind the module alone —
# this trims the site, it does not revoke access. Only "true" or "false" are
# accepted; anything else fails the build rather than guessing.

NEXT_PUBLIC_MODULE_EVALUATIONS=true
NEXT_PUBLIC_MODULE_STATISTICS=true
NEXT_PUBLIC_MODULE_NEWSLETTER=true
NEXT_PUBLIC_MODULE_RULE_MODIFICATIONS=true
NEXT_PUBLIC_MODULE_SCHEDULER_UPDATES=true
NEXT_PUBLIC_MODULE_MAIL=true
NEXT_PUBLIC_MODULE_ADMIN_LOGS=true
NEXT_PUBLIC_MODULE_ADMIN_EMAIL_HISTORY=true

# -----------------------------------------------------------------------------
# Role mailboxes (server-only — override individual addresses)
# -----------------------------------------------------------------------------
# Each defaults to `<role>@NEXT_PUBLIC_EMAIL_DOMAIN`. Set NEXT_PUBLIC_EMAIL_DOMAIN
# alone to move all of them at once; set one of these individually only if that
# role's real inbox should differ from the derived address. Never add a
# NEXT_PUBLIC_ alias to any of these — see lib/siteConfig.ts.

EMAIL_NO_REPLY=
EMAIL_ANNOUNCEMENTS=
EMAIL_SCHEDULER=
EMAIL_TREASURER=
EMAIL_SECRETARY=
EMAIL_MEMBER_SERVICES=
EMAIL_EDUCATION=
EMAIL_WEBMASTER=
EMAIL_PERFORMANCE=
EMAIL_RECRUITING=
EMAIL_INFO=

# Per-submission overrides for the OSA scheduling webhook
# (netlify/functions/osa-webhook.ts). Optional — each falls back to the
# matching EMAIL_* role address above.
OSA_SENDER_EMAIL=
OSA_SCHEDULER_EMAIL=
OSA_TREASURER_EMAIL=
OSA_PRESIDENT_EMAIL=

# -----------------------------------------------------------------------------
# Transactional email provider (required for password reset / invites / mail)
# -----------------------------------------------------------------------------
# One provider, chosen by EMAIL_PROVIDER. See lib/email/index.ts.

# resend | smtp | graph
EMAIL_PROVIDER=resend

# --- resend --- (https://resend.com/api-keys)
RESEND_API_KEY=your-resend-api-key
# Override only for a self-hosted proxy or in tests; defaults to Resend's API.
RESEND_API_URL=

# --- smtp ---
SMTP_HOST=
# Defaults to 587 if unset.
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# Defaults to true when SMTP_PORT is 465, false otherwise.
SMTP_SECURE=
# Requires TLS (STARTTLS) unless explicitly set to true. Leave unset/false.
SMTP_ALLOW_INSECURE=

# --- graph (Microsoft 365 / Entra ID) ---
# Required when EMAIL_PROVIDER=graph. Also still read directly (independent of
# EMAIL_PROVIDER) by netlify/functions/osa-webhook.ts and verify-email.ts,
# which predate the provider abstraction. Register an app in Microsoft Entra
# ID with the Mail.Send application permission to get these three values.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Secret used to sign/verify the email-verification link
# (netlify/functions/verify-email.ts). Falls back to MICROSOFT_CLIENT_SECRET
# if unset — set this explicitly rather than relying on that fallback.
EMAIL_VERIFY_SECRET=

# -----------------------------------------------------------------------------
# Other optional services
# -----------------------------------------------------------------------------

# Google Safe Browsing API key for scanning contact-form attachment URLs.
# Optional — the check is skipped entirely when unset.
# Get one at https://developers.google.com/safe-browsing/v4/get-started
GOOGLE_SAFE_BROWSING_API_KEY=

# -----------------------------------------------------------------------------
# App behaviour flags (optional)
# -----------------------------------------------------------------------------

# Base path for API calls. Defaults to '/api'.
NEXT_PUBLIC_API_URL=

# Dev-only: skip auth checks in local development. Has no effect unless
# NODE_ENV=development too (see components/layout/PortalHeader.tsx). Never
# set this in a deployed environment.
NEXT_PUBLIC_DISABLE_AUTH_DEV=false

# Use mock/seed data instead of Supabase. Also true automatically whenever
# NODE_ENV=development.
NEXT_PUBLIC_USE_MOCK_DATA=false

# Route storage reads/writes through Supabase Storage instead of the local
# filesystem adapter.
NEXT_PUBLIC_USE_SUPABASE=false

# -----------------------------------------------------------------------------
# Integration tests only
# -----------------------------------------------------------------------------
# jest.integration.setup.ts loads .env.test (falling back to .env.local) and
# requires NEXT_PUBLIC_SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY above. This one
# is additionally optional there:

# Sink address used by __tests__/integration/osa-webhook.test.ts so test runs
# never email a real inbox. Has a safe built-in default — only set this if you
# want a different disposable address.
OSA_TEST_DEAD_INBOX=
